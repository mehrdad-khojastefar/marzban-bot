# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://marzban_bot:marzban_bot@localhost:5432/marzban_bot

# ─────────────────────────────────────────────────────────────
# Telegram
# ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_admin_telegram_chat_id

# ─────────────────────────────────────────────────────────────
# Marzban Panel
# ─────────────────────────────────────────────────────────────
MARZBAN_API_URL=https://your-marzban-panel.com
MARZBAN_USERNAME=your_marzban_admin_username
MARZBAN_PASSWORD=your_marzban_admin_password

# ─────────────────────────────────────────────────────────────
# Subscription Proxy
# ─────────────────────────────────────────────────────────────
SUB_BASE_URL=https://sub.mydoves.info:8085
MARZBAN_SUB_URL=http://internal-marzban-sub:8085
SUB_PORT=8085
CONFIG_LINK_PREFIX=🕊️ 🇩🇪  DE|

# ─────────────────────────────────────────────────────────────
# Bot Config
# ─────────────────────────────────────────────────────────────
SUPPORT_USERNAME=@your_support_username
CHANNEL_ID=-100XXXXXXXXXX
CHANNEL_INVITE_LINK=https://t.me/+your_invite_hash

# ─────────────────────────────────────────────────────────────
# Proxy (optional, dev only)
# ─────────────────────────────────────────────────────────────
# SOCKS5_PROXY=socks5://user:pass@host:port

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# Premzy Payment Gateway (optional — only when payment_method=premzy)
# ─────────────────────────────────────────────────────────────
PREMZY_VENDOR_ID=your-vendor-uuid
PREMZY_VENDOR_TOKEN=your-callback-auth-token
PREMZY_EC_PRIVATE_KEY_PATH=./keys/private.pem
PREMZY_CALLBACK_PORT=8086

# ─────────────────────────────────────────────────────────────
# Event Tracking
# ─────────────────────────────────────────────────────────────
# Every meaningful bot action is mirrored to a Telegram forum supergroup,
# organized by topic. Required at boot — set to placeholder values (e.g. 0)
# only if you also set the `events_enabled` BotSetting to "false".
#
# Setup:
#   1. Create a Telegram supergroup with "Topics" enabled (forum mode).
#   2. Add the bot as admin with permission to send messages.
#   3. Create 9 topics (USERS, PAYMENTS, ACCOUNTS, ADMIN, SELLER, ERRORS,
#      SYSTEM, BACKUP_MARZBAN, BACKUP_BOT).
#   4. To get a topic's message_thread_id: open the topic in Telegram Web
#      (web.telegram.org) — the URL contains `?topic=<id>`. Or forward a
#      message from the topic to @JsonDumpBot and read `message_thread_id`.
#
# Disable at runtime without unsetting these vars:
#   UPDATE bot_settings SET value='false' WHERE key='events_enabled';
LOG_GROUP_ID=-1001234567890
LOG_TOPIC_USERS=1
LOG_TOPIC_PAYMENTS=2
LOG_TOPIC_ACCOUNTS=3
LOG_TOPIC_ADMIN=4
LOG_TOPIC_SELLER=5
LOG_TOPIC_ERRORS=6
LOG_TOPIC_SYSTEM=7
# Backup topics — each DB dump is posted to its own topic in LOG_GROUP_ID.
LOG_TOPIC_BACKUP_MARZBAN=8
LOG_TOPIC_BACKUP_BOT=9

# ─────────────────────────────────────────────────────────────
# Group Modify
# ─────────────────────────────────────────────────────────────
# Parallel Marzban modify calls during admin group-modify batches.
# Raise for speed, lower if you see 503s from Marzban.
GROUP_MODIFY_CONCURRENCY=8

# ─────────────────────────────────────────────────────────────
# Database Backup
# ─────────────────────────────────────────────────────────────
# Connection string for the Marzban panel's Postgres instance. Used ONLY
# by the scheduled `pg_dump` job — never wired to Prisma. Point this at
# the same DB Marzban itself uses (read access is enough).
#
# Schedule + on/off live in bot_settings (runtime tunable, no redeploy):
#   UPDATE bot_settings SET value='true' WHERE key='backup_enabled';
#   UPDATE bot_settings SET value='0 3 * * *' WHERE key='backup_cron';
#
# Backup destination topics are LOG_TOPIC_BACKUP_MARZBAN and
# LOG_TOPIC_BACKUP_BOT in the Event Tracking section above.
MARZBAN_DATABASE_URL=postgresql://marzban:marzban@marzban-db:5432/marzban
